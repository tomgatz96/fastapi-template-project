# Copy this file to .env before running the stack:
#
#     cp .env.example .env
#
# Then replace every "changethis" value. Generate secrets with:
#
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# .env is git-ignored on purpose — never commit real credentials.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------

# Domain used by Traefik for routing and TLS certificates.
DOMAIN=localhost

# Where the frontend is served from. The backend uses this to build the links
# it puts in emails (e.g. password recovery).
FRONTEND_HOST=http://localhost:5173

# One of: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="Box-Doc Manager"
STACK_NAME=box-doc-manager

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------

BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173"

# Signs the JWT access tokens.
SECRET_KEY=changethis

# The admin account created on first startup by app/initial_data.py.
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Use "db" when running through Docker Compose, "localhost" when running the
# backend directly on your machine against the Compose database.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# ---------------------------------------------------------------------------
# Email (optional)
# ---------------------------------------------------------------------------
# Leave SMTP_HOST empty to disable outgoing email. In local development the
# Compose stack starts Mailcatcher on http://localhost:1080 instead.

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# ---------------------------------------------------------------------------
# Monitoring (optional)
# ---------------------------------------------------------------------------

SENTRY_DSN=

# ---------------------------------------------------------------------------
# Deployment only — not needed for local development
# ---------------------------------------------------------------------------

# Container image and tag pushed to your registry.
DOCKER_IMAGE_BACKEND=backend
TAG=latest

# Basic-auth credentials for the Traefik dashboard (compose.traefik.yml).
# Generate HASHED_PASSWORD with:
#     openssl passwd -apr1
USERNAME=admin
HASHED_PASSWORD=
EMAIL=admin@example.com
